---
import '../styles/globals.css'

const { currentPage, class: className } = Astro.props;
import Banner from '../components/banner/banner.astro'
---

<!doctype html>
<html lang="no">
	<head>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
    	<style>
        	body {
        		visibility: hidden;
        	}
    	</style>
    	<script>
        	document.fonts.ready.then(() => {
            	document.body.style.visibility = 'visible';

				document.querySelectorAll('.slide-up').forEach(el => {
            		(el as HTMLElement).style.animationPlayState = 'running'
        		})
			})
    	</script>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>(dev) Norsk Målungdom</title>
	</head>
	<body>
		<div class='fixed w-full z-200'>
			<Banner pagePath={currentPage} />
		</div>
		<div class='bannerH'/>
		<div id='master-div' class={`w-full ${className}`}>
			<slot />
		</div>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	
	}
	
	.bannerH {
		height: var(--banner-h-desktop);
	}

	@media(max-width: 768px) {
		.bannerH {
			height: var(--banner-h-mobile);
		}
	}
</style>
