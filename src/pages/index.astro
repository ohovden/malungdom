---
import Layout from '@layouts/Layout.astro';
import Button from '@components/shared/button.astro';
import Hero from '@components/index/hero.astro';
import Card from '@components/shared/card.astro';
import Hendingar from '@components/index/hendingar.astro';
import '@styles/globals.css';

const goalCards = [
    {
        head: 'Likeverd mellom nynorsk og bokmål',
        image: 'aasen.png',
        link: ''
    },
    {
        head: 'Styrking av sidemåls\u00ADundervisinga',
        image: 'grammatikk.png',
        link: ''
    },
    {
        head: 'Lover som respekterer språkleg mangfald',
        image: 'fireflag.png',
        link: ''
    },
]
---

<Layout currentPage='/' class=''>
    <Hero id='hero-section'/>
    <div id='margined-master' class='flex flex-col text-center gap-20 py-20 px-5 md:px-30'>
        <h1 class='text-7xl'>Kva kjempar me for?</h1>
        <div id='goal-cards' class='h-fit grid grid-cols-1 md:grid-cols-3 gap-15'>
            {goalCards.map( ({ head, image, link }) => (
                <Card colorSet='var(--main-blue)' class='grid grid-rows-[1fr_auto_auto] gap-10 md:gap-20 py-10 px-10 rounded-2xl '>
                    <h1 class='text-white text-3xl md:text-5xl text-center'>{head}</h1>
                    <img src={image} class='h-full mx-auto items-center'>
                    <a href={link} class='flex flex-row m-auto gap-2 text-center text-3xl text-white font-bold'>
                            <p class='hover:translate-x-2 transition duration-300'>Les meir ></p>
                    </a>
                </Card>
            ))}
        </div>
        <div id='hending-section' class='grid grid-cols-1 md:grid-cols-3 gap-20'>
            <h1 class='text-left text-6xl col-span-1'>Kvissleis skjer fram&shy;over?</h1>
            <Hendingar class='col-span-2' />
        </div>
    </div>

</Layout>