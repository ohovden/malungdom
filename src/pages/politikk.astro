---
import Welcome from '../components/Welcome.astro';
import Layout from '../layouts/Layout.astro';
import Button from '../components/shared/button.astro'
import Card from '../components/shared/card.astro';
import FraasegnModal from '../components/politikk/fraasegner';

import { getCollection } from 'astro:content';

const fraasegner = await getCollection('fraasegner');

const politiskProgram = [
	{
		title: 'Arbeids\u00ADprogram',
		path: '/politikk/program/arbeidsprogram/2025-2026',
		image: '/politikk/kalender.png'
	},
	{
		title: 'Inter\u00ADnasjonalt Program',
		path: '/politikk/program/internasjonalt-program',
		image: '/politikk/mangeflag.png'
	},
	{
		title: 'Program for Noreg som fleir\u00ADspråkleg samfunn',
		path: '/politikk/program/noreg-som-fleirsprakleg-samfunn',
		image: '/politikk/samisk.png'
	},
	{
		title: 'Nynorsk i lærar\u00ADutdanning',
		path: '/politikk/program/nynorsk-i-laerarutdanningane',
		image: '/politikk/kalender.png'

	},
	{
		title: 'Språk i akademia og høgare utdanning',
		path: '/politikk/program/sprak-i-akademia-og-høgare-utdanning',
		image: '/politikk/kalender.png'

	},
	{
		title: 'Språk i skulen',
		path: '/politikk/program/sprak-i-skulen',
		image: '/politikk/kalender.png'

	},
	{
		title: 'Språk i ein digital kvardag',
		path: '/politikk/program/sprak-i-ein-digital-kvardag',
		image: '/politikk/kalender.png'

	},
	{
		title: 'Talemålet og nynorsken',
		path: '/politikk/program/talemalet-og-nynorsken',
		image: '/politikk/kalender.png'

	},
]
---

<Layout currentPage='/politikk'>
	<!--Hero-seksjon -->
	<section class='grid grid-cols-1 md:grid-cols-2 bg-[var(--main-grey)]'>
		<img src='/marentalar.jpg' />
		<div class='flex justify-center mx-10 md:mx-auto my-10 md:my-auto text-left md:text-justify italic '>
			<div class='flex flex-col w-full max-w-3xl gap-10'>
				<h1 class='text-left md:text-center text-5xl md:text-7xl not-italic'>Den politiske verksemda vår</h1>
				<p>Norsk Målungdom verjar og fremjar interessene til nynorsk og dialektane og samarbeider aktivt med Noregs Mållag for å få politiske gjennomslag for nynorsk.</p>
				<p>NMU utformar sin eigen politikk og arbeidsprogram og skriv fråsegner om aktuelle tema som du kan lesa her.
				</p>
			</div>
		</div>
	</section>
	<!--Vanleg seksjon-->
	<section class='flex flex-col text-center gap-[var(--global-gap)] margined'>
		<!--Element for arbeidsprogram-->
		<div class='grid grid-cols-1 md:grid-cols-3'>
			<div class='w-fit m-auto'>
				<h1 class='text-7xl px-8 py-5'>Politiske program</h1>
			</div>
			<div class='p-5 text-left md:col-span-2 h-full items-center align-center'>
				<p class='italic'>NMU vedtar ulike politiske program som legg grunnlag for organisajonen. Dei politiske programma er tankegrunnlaget til dei politiske standpunkta våre.</p>
			</div>
		</div>
		<nav class='grid grid-cols-1 md:grid-cols-2 gap-5 md:gap-5 mx-5'>
				{politiskProgram.map((program) => ( 
					<a href={program.path} class='w-full ease-in-out isolate'>
						<Card colorSet='var(--light-blue)' class='p-10'>
							<p class='text-center text-2xl'>{program.title}</p>
						</Card>
					</a>
				))}
		</nav>
	</section>
	<!--Fråsegner-->
	<section class='margined flex flex-col text-center gap-[var(--global-gap)]'>
		<div class='grid grid-cols-1 md:grid-cols-3'>
			<div class='p-5 text-left md:col-span-2 h-full items-center align-center'>
				<p class='italic'>Les våre utrop om aktuelle tema</p>
			</div>
			<div class='w-fit m-auto'>
				<h1 class='text-7xl px-8 py-5'>Fråsegner</h1>
			</div>
		</div>

	</section>
</Layout>

<script>

</script>