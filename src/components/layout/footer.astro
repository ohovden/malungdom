---
const { class: className } = Astro.props;
---

<footer class={`w-full bg-[var(--main-blue)] ${className}`}>
    <div class='flex flex-col md:flex-row gap-15 justify-between w-full max-w-[1200px] mx-auto py-10'>
        <nav class='navSec'>
            <h2>Ta kontakt</h2>
            <a>Kontaktskjema</a>
            <a>Folka våre</a>
        </nav>
        <nav class='navSec'>
            <h2>For medlem</h2>
            <a>Lokallagshandboka</a>
            <a>Utleggskjema</a>
            <a>Frifond</a>
            <a href='/songheftet'>Songheftet</a>
        </nav>
        <nav class='navSec'>
            <h2>Språkrettar</h2>
            <a>Elevrettar</a>
            <a>Studentrettar</a>
            <a>Klageportalen</a>
        </nav>
        <nav class='navSec'>
            <h2>Nettside</h2>
            <a href='/undersider'>Alle undersider</a>
            <a href='/admin/index.html'>Adminpanel</a>
            <a href='https://github.com/ohovden/malungdom'>Kjeldekode</a>
            <a>Bileteopphavstilvising</a>
        </nav>
    </div>
    <div class='flex flex-col items-center pb-10'>
        <p class='text-white font-extralight text-[1.3rem]'>Rammeverk: <a class='font-normal' href='https://astro.build/'>Astro</a> med <a class='font-normal' href='https://sveltiacms.app/en/'>Sveltia CMS</a></p>
        <p class='text-white font-extralight text-[1.3rem]'>Design og utvikling: <a class='font-normal' href='https://www.linkedin.com/in/oliver-hovden-2aa9b0379/'>Oliver Hovden</a></p>
    </div>
</footer>

<style>
    .navSec {
        color: white;
        display: flex;
        gap: 8px;
        flex-direction: column;
    }
    .navSec h2 {
        text-align: left;
        font-size: 2rem;
        font-weight: 200;
        text-transform: uppercase;
    }
    .navSec a {
        font-size: 1.3rem;
        font-weight: 200;
    }

    @media (max-width: 768px) {
        .navSec {
            text-align: center;
        }
        .navSec h2 {
            text-align: center;
        }
    }
</style>