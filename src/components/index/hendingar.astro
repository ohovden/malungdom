---
import { getCollection } from "astro:content";
import Card from '../shared/card.astro';
import '../../styles/globals.css';

import CalendarIcon from '@assets/images/calendar.png'
import LocationIcon from '@assets/images/pinpoint.png'

const { class: className } = Astro.props;

const hendingar = await getCollection('hendingar');

const dateOptions: object = {
    month: 'long',
    day: 'numeric'
}

/*
                <div id='timeplace' class='grid grid-cols-[auto_1fr] gap-3 md:gap-3'>
*/

---

<div class={`w-full grid grid-cols-1 gap-10 ${className}`}>
    {hendingar.map((hending) => (
        <Card colorSet='var(--light-grey)' borderwidth='2px' class='rounded-3xl shadow-2xl grid md:grid-cols-2 overflow-clip'>
            <div id={`card-text-${hending.data.title}`} class='px-5 py-8 md:px-10 grid grid-cols-[auto_1fr] gap-5'>
                <h1 class='text-left text-3xl md:text-4xl font-bold col-span-2'>{hending.data.title}</h1>
                <img class='-translate-y-1 md:translate-y-0' src={CalendarIcon.src} /> 
                <p>{hending.data.place}</p>
                <img class='-translate-y-1 md:translate-y-0' src={LocationIcon.src} /> 
                <p>{hending.data.date.toLocaleDateString('nn-NO', dateOptions)}{hending.data.enddate ? ` - ${hending.data.enddate.toLocaleDateString('nn-NO', dateOptions)}` : ``}</p>
                <p class='col-span-2'><a class='text-link' href={hending.data.slug}>Les meir! ></a></p>
            </div>
            <img src={hending.data.image} class='overflow-clip h-full'>
        </Card>
    ))}
</div>
