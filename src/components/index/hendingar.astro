---
import { getCollection } from "astro:content";
import Card from '../shared/card.astro';
import '../../styles/globals.css';

import CalendarIcon from '@assets/images/calendar.png'
import LocationIcon from '@assets/images/pinpoint.png'

const { class: className } = Astro.props;

const hendingar = await getCollection('hendingar');

const dateOptions: object = {
    month: 'long',
    day: 'numeric'
}
---

<div class={`w-full ${className}`}>
    {hendingar.map((hending) => (<div>
        <Card colorSet='var(--light-grey)' class='w-full m-auto text-left text-2xl rounded-3xl shadow-2xl grid md:grid-cols-2 overflow-clip'>
            <div id={`card-text-${hending.data.title}`} class='p-10 grid grid-cols-1 gap-5'>
                <h1 class='text-left text-4xl font-bold'>{hending.data.title}</h1>
                <div id='timeplace' class='grid grid-cols-[auto_1fr] gap-5'>
                    <img class='translate-y-1' src={CalendarIcon.src}> 
                    </p>{hending.data.place}</p>
                    <img class='translate-y-1' src={LocationIcon.src}> 
                    <p>{hending.data.date.toLocaleDateString('nn-NO', dateOptions)}{hending.data.enddate ? ` - ${hending.data.enddate.toLocaleDateString('nn-NO', dateOptions)}` : ``}</p>
                </div>
                <p><a class='text-link' href={hending.data.slug}>Les meir! ></a></p>
            </div>
            <img src={hending.data.image} class='overflow-clip h-full'>
        </Card>
    </div>))}
</div>
