
---
import Button from '@components/shared/button.astro';

const { class: className } = Astro.props;
---

<div class={`${className} mb-20 mx-5 md:mx-auto md:p-8 flex flex-col gap-20 md:backdrop-blur-md max-w-3xl md:rounded-4xl md:bg-[#666666bb]`}>
    <p class='text-black md:text-white text-[15pt] md:text-3xl text-left md:text-justify font-light italic pb-5'>
		Norsk Målungdom er eit landsdekkjande mållag med over 1200 elevar og studentar som kjempar for nynorsk, dialekt og språkmangfald i Noreg. 
    </p>
    <Button id='hero-CTAbutton' colorSet='lav' path='/omnmu' classes='w-full'>
        <p>Meld deg inn!</p>
    </Button>
</div>