---
import Layout from '@layouts/Layout.astro';
import CTAcard from '@components/index/CTAcard.astro';

const { id: divId } = Astro.props;
---

<div id={divId}>
    <div class='slide-up delay-2 w-full h-auto'>
    		<div id='hero-gradient' class='absolute inset-0 w-full h-full bg-linear-to-t from-(--main-lav)/30 via-white/5 to-black/50'/>
            <div id='hero-foreground' class='absolute w-full h-full flex flex-col justify-between'>
                <div id='hero-headline' class='hidden md:block size-fit mx-auto mt-5 md:mt-10 p-1 md:p-3 rounded-4xl bg-(--main-green)'>
                    <h1 class='text-white text-2xl md:text-7xl'>Ver med og kjemp for språket vårt!</h1>
                </div>
                <CTAcard id='CTA-desktop' class='hidden md:block'/>
            </div>
        <img src='/smib.webp' class='w-full h-auto md:h-[calc(100svh-var(--banner-h-desktop))] md:object-center md:object-cover'>
    </div>
    <div id='headline-CTA-mobile' class='md:hidden'>
        <h1 id='headline-mobile' class='m-5 text-left text-3xl pt-5'>
            Ver med og kjemp for språket vårt!
        </h1>
        <CTAcard id='CTA-mobile'/>
    <div/>
</div>