---
const { borderColor = 'main-green', class: className = "" } = Astro.props;
//<div class={`textCard ${className} `} style={`--border-color: var(--${borderColor})`}>
---

<div class={`textCard ${className}`} style={`--border-color: var(--${borderColor})`}>
    <slot />
</div>

<style>
  .textCard {
    background-color: hwb(214 70% 20% / 0.223);
    height: fit-content;
    padding: 2.5rem;
    border-radius: 15px;
    border: 0rem solid var(--border-color);
    text-align: justify;
    margin: 3rem 3rem 3rem 3rem;
  }

  .textCard :global(p) {
    color: #000b00;
    font-size: 1.1rem;
  }
  .textCard :global(h1) {
    color: #002e04;
    text-align: center;
    font-size: 3rem;
    padding-bottom: 0.3rem;
    padding-top: 1.8rem;
  }
  .textCard :global(h2) {
    color: #002e04;
    font-size: 2rem;
    padding-top: 1rem;
    padding-bottom: -0.1rem;
    text-transform: uppercase;
    font-weight: 300;
    letter-spacing: 0.08em;
  }

  @media(max-width: 768px) {
    .textCard {
      text-align: left;
      margin: 1.5rem 1.5rem 1.5rem 1.5rem;
    }

    .textCard :global(p) {
      font-size: 1.2rem;
    }
    .textCard :global(h1) {
      text-align: left;
      font-size: 3rem;
      padding-bottom: 1.5rem;
    }
  }
</style>